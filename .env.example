# Preencha os valores de senha com credenciais locais. Use a mesma senha
# em POSTGRES_PASSWORD e DATABASE_URL. Codifique caracteres reservados na URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://stock:@127.0.0.1:5432/stock
API_BIND=127.0.0.1:3000
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=equipment-labels
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ALLOW_HTTP=true

# Worker local de OCR. O executável usa os dados de idioma instalados no sistema.
OCR_TESSERACT_BIN=tesseract
OCR_LANGUAGE=eng

# Token independente de coleta. Vazio mantém /metrics indisponível.
METRICS_TOKEN=
API_AUTO_MIGRATE=true
# Origem HTTPS opcional para links assinados quando o S3 estiver em rede privada.
S3_PUBLIC_ENDPOINT=
